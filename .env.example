# --- Grafana Cloud ---
GRAFANA_STACK_URL=https://yourstack.grafana.net
GRAFANA_PROMETHEUS_URL=https://prometheus-prod-XX-XXX.grafana.net/api/prom/push
GRAFANA_PROMETHEUS_USERNAME=
GRAFANA_PROMETHEUS_API_KEY=
GRAFANA_LOKI_URL=https://logs-prod-XXX.grafana.net/loki/api/v1/push
GRAFANA_LOKI_USERNAME=
GRAFANA_LOKI_API_KEY=
# Used by the open-source grafana/mcp-grafana server (both local dev and prod):
# the hosted mcp.grafana.com endpoint requires interactive OAuth and doesn't
# respond to headless/service clients, so we run mcp-grafana ourselves.
GRAFANA_SERVICE_ACCOUNT_TOKEN=
# Leave blank for local dev (spawns mcp-grafana via Docker). Set to the
# mcp-grafana Cloud Run service URL when deployed (Cloud Run can't spawn
# nested Docker containers) -- see agent/grafana_toolset.py.
MCP_GRAFANA_URL=

# --- Google Cloud / Vertex AI Agent Engine ---
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true

# --- Parallel AI (bonus grounding tool) ---
PARALLEL_API_KEY=
